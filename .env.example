# 帖子链接（可换成任意公开的 QQ频道图文/视频帖子）
QQDL_URL=https://pd.qq.com/g/605695554027767602/post/B_51a2d56ad69b05001441152189397568750X60
# 宿主机下载目录（相对 docker-compose.yml 或绝对路径）
DOWNLOAD_DIR=./downloads
# 并发下载数
QQDL_JOBS=4

# ---- 仅 docker-compose.webui.yml 使用 ----
# WebUI 宿主机端口
WEB_PORT=8765
# 容器时区
TZ=Asia/Shanghai

# 默认 compose（WebUI）与命令行 compose
# ---- Docker 构建加速源（国内网络） ----
GO_IMAGE=docker.m.daocloud.io/library/golang:1.22-alpine
ALPINE_IMAGE=docker.m.daocloud.io/library/alpine:3.20
ALPINE_MIRROR=https://mirrors.aliyun.com/alpine
GOPROXY=https://goproxy.cn,direct
